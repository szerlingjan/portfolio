---
import type { GalleryDownloadImage } from "~/scripts/download-gallery";

interface Props {
  galleryName: string;
  images: GalleryDownloadImage[];
}

const { galleryName, images } = Astro.props;
const imagesJson = JSON.stringify(images);
---

<div class="gallery-header">
  <button
    type="button"
    class="download-all-btn"
    data-gallery-name={galleryName}
    data-images={imagesJson}
    disabled={images.length === 0}
  >
    Download gallery
  </button>
  <span class="download-status" aria-live="polite"></span>
</div>

<script>
  import { downloadGallery } from "~/scripts/download-gallery";

  document.querySelectorAll<HTMLButtonElement>(".download-all-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const galleryName = btn.dataset.galleryName;
      const imagesJson = btn.dataset.images;
      const statusEl = btn.parentElement?.querySelector(".download-status");

      if (!galleryName || !imagesJson) return;

      const images = JSON.parse(imagesJson) as { src: string; filename: string }[];
      const defaultLabel = btn.textContent;

      btn.disabled = true;

      try {
        await downloadGallery(galleryName, images, (message) => {
          if (statusEl) statusEl.textContent = message;
        });
        if (statusEl) statusEl.textContent = "Download started";
      } catch (error) {
        if (statusEl) {
          statusEl.textContent =
            error instanceof Error ? error.message : "Download failed";
        }
      } finally {
        btn.disabled = false;
        btn.textContent = defaultLabel;
        setTimeout(() => {
          if (statusEl) statusEl.textContent = "";
        }, 3000);
      }
    });
  });
</script>

<style>
  .gallery-header {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto 20px;
  }

  .download-all-btn {
    background: transparent;
    border: 1px solid #333;
    color: #b3b3b3;
    font-family: Cambria, Georgia, serif;
    font-size: 0.9rem;
    padding: 10px 18px;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .download-all-btn:hover:not(:disabled) {
    color: #fff;
    border-color: #666;
  }

  .download-all-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .download-status {
    color: #666;
    font-size: 0.85rem;
  }
</style>
