---
import GalleryDownloadAll from "~/components/GalleryDownloadAll.astro";
import GalleryGrid from "~/components/GalleryGrid.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { loadGalleryImages } from "~/utils/loadGalleryImages";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../images/hotpot/*.{jpg,jpeg,png,webp}",
);

const galleryImages = await loadGalleryImages(images);
const downloadImages = galleryImages.map(({ src, filename }) => ({
  src,
  filename,
}));
---

<BaseLayout
  title="China Hotpot Bakalarska"
  description="Photography Portfolio Gallery"
>
  <GalleryDownloadAll galleryName="hotpot" images={downloadImages} />
  <GalleryGrid images={galleryImages} />
</BaseLayout>

<style>
  :global(body) {
    background-color: #0a0a0a !important;
  }
</style>
