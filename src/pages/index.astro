---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";

// 1. IMPORT ALL YOUR COVER PHOTOS HERE AT THE TOP
import hotpotCover from "../images/hotpot-cover.jpg";
import isabergCover from "../images/isaberg-cover.jpg";
import kirunaCover from "../images/kiruna-cover.jpg";

// 2. THE GALLERY LIST: Add new shoots here effortlessly!
const galleries = [
  {
    title: "Isaberg Session",
    subtitle: "8.08.2026",
    url: "/isaberg26",
    cover: isabergCover,
  },
  {
    title: "China Hotpot Bakalarska",
    subtitle: "27.07.2026",
    url: "/hotpot",
    cover: hotpotCover,
  },
  {
    title: "Pumptrack Arctic Series - Kiruna",
    subtitle: "View 24 Photos",
    url: "/kiruna",
    cover: kirunaCover,
  },
];
---

<BaseLayout title="Portfolio" description="Photography Portfolio">
  <main class="justified-gallery">
    
    {galleries.map((gallery) => {
      const imgMeta = gallery.cover;
      const isLandscape = imgMeta.width > imgMeta.height;
      
      return (
        <div class={`gallery-container ${isLandscape ? 'landscape' : 'portrait'}`}>
          <a 
            href={gallery.url} 
            class="gallery-item" 
            style={`--width: ${imgMeta.width}; --height: ${imgMeta.height};`}
          >
            <div class="image-wrapper">
              <Image src={gallery.cover} alt={gallery.title} />
              <div class="hover-text">
                <h2>{gallery.title}</h2>
                <p>{gallery.subtitle}</p>
              </div>
            </div>
          </a>
          
          <a href={gallery.url} class="mobile-caption">
            <h2>{gallery.title}</h2>
            <p>{gallery.subtitle}</p>
          </a>
        </div>
      );
    })}

  </main>
</BaseLayout>

<style>
  :global(body) {
    background-color: #0a0a0a !important;
  }

  .justified-gallery {
    --padding: 40px;
    --space: 24px;
    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
    max-width: 1500px;
    margin: 0 auto;
  }

  /* Structural wrapper for each gallery item + its caption */
  .justified-gallery .gallery-container.landscape {
    width: 100%;
  }

  .justified-gallery .gallery-container.portrait {
    width: calc(50% - (var(--space) / 2));
  }

  .justified-gallery .gallery-item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0 !important;
    text-decoration: none !important;
  }

  .justified-gallery .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .justified-gallery img {
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
    max-height: 85vh;
    aspect-ratio: var(--width) / var(--height);
    border-radius: 0 !important;
  }

  /* PC Hover Overlay */
  .justified-gallery .hover-text {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .justified-gallery .hover-text h2 {
    margin: 0 0 6px 0;
    font-weight: 400;
    letter-spacing: 1px;
    font-size: 1.5rem;
  }

  .justified-gallery .hover-text p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
    letter-spacing: 0.5px;
  }

  .justified-gallery .gallery-item:hover .hover-text {
    opacity: 1;
  }

  /* Completely hidden on PC */
  .justified-gallery .mobile-caption {
    display: none !important;
  }

  /* Mobile Layout */
  @media (max-width: 768px) {
    .justified-gallery {
      padding: 0 16px;
      gap: 36px;
    }

    .justified-gallery .gallery-container.landscape,
    .justified-gallery .gallery-container.portrait {
      width: 100%;
    }

    /* Disable hover effects entirely on mobile */
    .justified-gallery .hover-text {
      display: none !important;
    }

    /* Show caption below photo on mobile */
    .justified-gallery .mobile-caption {
      display: block !important;
      padding-top: 10px;
      text-decoration: none !important;
    }

    .justified-gallery .mobile-caption h2 {
      margin: 0 0 4px 0;
      font-weight: 400;
      font-size: 1.1rem;
      letter-spacing: 0.5px;
      color: #ffffff !important;
      text-decoration: none;
    }

    .justified-gallery .mobile-caption p {
      margin: 0;
      font-size: 0.85rem;
      opacity: 0.6;
      color: #cccccc !important;
      text-decoration: none;
    }
  }
</style>