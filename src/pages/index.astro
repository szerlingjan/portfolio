---
import BaseLayout from "~/layouts/BaseLayout.astro";

// Bulletproof base path helper
const base = import.meta.env.BASE_URL || "/portfolio/";
const prefix = base.startsWith("/") ? base : `/${base}`;
const normalizedBase = prefix.endsWith("/") ? prefix : `${prefix}/`;

// THE GALLERY LIST: Hosted on Cloudinary
// Configured in the exact order requested with available covers
const galleries = [
  {
    title: "Marma Pumptrack Competition",
    subtitle: "14-16.08.2026",
    url: `${normalizedBase}marma/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787129183/marma-cover.jpg",
    width: 3000,
    height: 4000,
  },
  {
    title: "Isaberg Session",
    subtitle: "8.08.2026",
    url: `${normalizedBase}isaberg26/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066501/isaberg-cover.jpg",
    width: 3000,
    height: 4000,
  },
  {
    title: "China Hotpot Bakalarska",
    subtitle: "27.07.2026",
    url: `${normalizedBase}hotpot/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066500/hotpot-cover.jpg",
    width: 3010,
    height: 4000,
  },
  {
    title: "Pickleball Polish Cup",
    subtitle: "17-19.07.2026",
    url: `${normalizedBase}pickleball/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066500/pickleball-cover.jpg",
    width: 3010,
    height: 4000,
  },
  {
    title: "Pumptrack Arctic Series - Kiruna",
    subtitle: "View Photos",
    url: `${normalizedBase}kiruna/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066501/kirunacover.jpg",
    width: 4000,
    height: 3000,
  },
  {
    title: "Pumptrack Arctic Series - Narvik",
    subtitle: "View Photos",
    url: `${normalizedBase}narvik-spts/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066501/narvik-cover.jpg",
    width: 3000,
    height: 4000,
  },
  {
    title: "Pumptrack Arctic Series - Ylläs",
    subtitle: "View Photos",
    url: `${normalizedBase}yllas-spts/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066501/yllas-cover.jpg",
    width: 3000,
    height: 4000,
  },
  {
    title: "Crankworx 2024",
    subtitle: "View Photos",
    url: `${normalizedBase}crankworx24/`,
    cover:
      "https://res.cloudinary.com/mvsmxpee/image/upload/v1787066501/crankworx24-cover.jpg",
    width: 4000,
    height: 3000,
  },
];
---

<BaseLayout title="Portfolio" description="Photography Portfolio">
  <main class="justified-gallery">
    
    {galleries.map((gallery) => {
      // Read dimensions directly from the gallery object instead of local metadata
      const isLandscape = gallery.width > gallery.height;
      
      return (
        <div class={`gallery-container ${isLandscape ? 'landscape' : 'portrait'}`}>
          <a 
            href={gallery.url} 
            class="gallery-item" 
            style={`--width: ${gallery.width}; --height: ${gallery.height};`}
          >
            <div class="image-wrapper">
              <!-- Replaced <Image /> with standard <img> tag pointing directly to Cloudinary -->
              <img src={gallery.cover} alt={gallery.title} loading="lazy" />
              <div class="hover-text">
                <h2>{gallery.title}</h2>
                <p>{gallery.subtitle}</p>
              </div>
            </div>
          </a>
          
          <a href={gallery.url} class="mobile-caption">
            <h2>{gallery.title}</h2>
            <p>{gallery.subtitle}</p>
          </a>
        </div>
      );
    })}

  </main>
</BaseLayout>

<style>
  :global(body) {
    background-color: #0a0a0a !important;
  }

  .justified-gallery {
    --padding: 40px;
    --space: 24px;
    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
    max-width: 1500px;
    margin: 0 auto;
  }

  /* Structural wrapper for each gallery item + its caption */
  .justified-gallery .gallery-container.landscape {
    width: 100%;
  }

  .justified-gallery .gallery-container.portrait {
    width: calc(50% - (var(--space) / 2));
  }

  .justified-gallery .gallery-item {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0 !important;
    text-decoration: none !important;
  }

  .justified-gallery .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .justified-gallery img {
    display: block;
    object-fit: cover;
    width: 100%;
    height: auto;
    max-height: 85vh;
    aspect-ratio: var(--width) / var(--height);
    border-radius: 0 !important;
  }

  /* PC Hover Overlay */
  .justified-gallery .hover-text {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .justified-gallery .hover-text h2 {
    margin: 0 0 6px 0;
    font-weight: 400;
    letter-spacing: 1px;
    font-size: 1.5rem;
  }

  .justified-gallery .hover-text p {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
    letter-spacing: 0.5px;
  }

  .justified-gallery .gallery-item:hover .hover-text {
    opacity: 1;
  }

  /* Completely hidden on PC */
  .justified-gallery .mobile-caption {
    display: none !important;
  }

  /* Mobile Layout */
  @media (max-width: 768px) {
    .justified-gallery {
      padding: 0 16px;
      gap: 36px;
    }

    .justified-gallery .gallery-container.landscape,
    .justified-gallery .gallery-container.portrait {
      width: 100%;
    }

    /* Disable hover effects entirely on mobile */
    .justified-gallery .hover-text {
      display: none !important;
    }

    /* Show caption below photo on mobile */
    .justified-gallery .mobile-caption {
      display: block !important;
      padding-top: 10px;
      text-decoration: none !important;
    }

    .justified-gallery .mobile-caption h2 {
      margin: 0 0 4px 0;
      font-weight: 400;
      font-size: 1.1rem;
      letter-spacing: 0.5px;
      color: #ffffff !important;
      text-decoration: none;
    }

    .justified-gallery .mobile-caption p {
      margin: 0;
      font-size: 0.85rem;
      opacity: 0.6;
      color: #cccccc !important;
      text-decoration: none;
    }
  }
</style>