---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="License" description="Photo licensing information">
  <div class="page-content">
    <h1>License</h1>
    <p>Licensing terms coming soon.</p>
  </div>
</BaseLayout>

<style>
  .page-content {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px 0;
  }

  h1 {
    color: #fff;
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0 0 16px 0;
  }

  p {
    color: #999;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
