---
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { v2 as cloudinary } from "cloudinary";

// 1. Configure Cloudinary
cloudinary.config({
  cloud_name: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME,
  api_key: import.meta.env.CLOUDINARY_API_KEY,
  api_secret: import.meta.env.CLOUDINARY_API_SECRET,
  secure: true,
});

// Automatically extract the slug from the URL path (e.g., "/portfolio/crankworx24/" -> "crankworx24")
const pathname = Astro.url.pathname;
const slug = pathname.split("/").filter(Boolean).pop() || "";

// Dynamically set folder path to match file/route name
const folderPath = `images/${slug}`;
let photos = [];

try {
  console.log(`\n🔍 Searching Cloudinary for folder: "${folderPath}"...`);

  const searchResult = await cloudinary.search
    .expression(`folder:"${folderPath}"`)
    .sort_by("public_id", "asc")
    .max_results(150)
    .execute();

  photos = searchResult.resources.filter(
    (file: any) => file.resource_type === "image",
  );
  console.log(`✅ Success! Found ${photos.length} photos in ${folderPath}.`);
} catch (error) {
  console.error("❌ CLOUDINARY ERROR:");
  console.error(error);
}
---

<BaseLayout title="Isaberg Gallery" description="Photography Portfolio Gallery">
  <section class="justified-gallery" id="photoswipe">
    {
      photos.length === 0 ? (
        <h2 style="color: white; padding-top: 50px;">No photos found. Check your terminal!</h2>
      ) : (
        photos.map((photo: any, index: number) => {
          // Bumping the height to 800px ensures crisp, high-quality thumbnails on Retina/4K displays
          const thumbUrl = cloudinary.url(photo.public_id, {
            height: 800,
            crop: "scale",
            fetch_format: "auto",
            quality: "auto",
            secure: true,
          });

          // The full resolution secure URL
          const fullUrl = photo.secure_url;

          return (
            <div class="gallery-item" style={`--width: ${photo.width}; --height: ${photo.height};`}>
              <a href={fullUrl} target="_blank" data-fancybox="gallery">
                <img src={thumbUrl} alt="Gallery Image" loading={index < 20 ? "eager" : "lazy"} />
              </a>
              <a href={fullUrl} download class="download-btn" title="Download Image">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </div>
          );
        })
      )
    }
  </section>
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  Fancybox.bind("[data-fancybox]", {
    theme: "auto",
    mainStyle: {
      "--f-button-width": "44px",
      "--f-button-height": "44px",
      "--f-button-border-radius": "50%",
      "--f-toolbar-padding": "16px",
    },
    Carousel: {
      Arrows: false,
      Toolbar: {
        display: {
          left: [],
          middle: [],
          // Added "download" here so the user can grab the high-res file while viewing fullscreen
          right: ["download", "close"], 
        },
      },
      transition: "slide",
    },
  });
</script>

<style>
  :global(body) {
    background-color: #0a0a0a !important;
  }

  .justified-gallery {
    --padding: max(2.5vw, 12px);
    --space: max(2.5vw, 12px);
    --min-height: clamp(180px, 20vw, 400px);

    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);
    max-width: 1400px;
    margin: 0 auto;

    .gallery-item {
      position: relative;
      /* On desktop: calculate justified layout */
      flex-grow: calc(var(--width) * (100000 / var(--height)));
      flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
      aspect-ratio: var(--width) / var(--height);
      overflow: hidden;
    }

    a {
      display: block;
      width: 100%;
      height: 100%;
    }

    a img {
      display: block;
      object-fit: cover;
      height: 100%;
      width: 100%;
      border-radius: 0 !important;
    }

    /* Styling for the download icon button */
    .download-btn {
      position: absolute;
      bottom: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
      background: rgba(0, 0, 0, 0.6);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
      border-radius: 0 !important;
      z-index: 2;
    }

    .gallery-item:hover .download-btn {
      opacity: 1;
    }

    .download-btn:hover {
      background: rgba(0, 0, 0, 0.9);
    }

    &::after {
      content: " ";
      flex-grow: 1000000000;
    }
  }

  /* MOBILE FIX: Let 1-column images scale naturally without cropping top/bottom */
  @media (max-width: 640px) {
    .justified-gallery {
      .gallery-item {
        flex-grow: 0;
        flex-basis: 100%; /* Force 1 full-width column on mobile */
        height: auto;
      }

      /* Make download button always visible on mobile since there is no hover state */
      .download-btn {
        opacity: 0.8;
      }
    }
  }
</style>