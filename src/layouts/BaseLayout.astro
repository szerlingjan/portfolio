---
import "~/styles/reset.css";
import "~/styles/base.css";

import smartypants from "smartypants";

const siteName = "Astro Photo Grid";

export interface Props {
  title: string;
  description: string;
  image?: {
    src: string;
    alt: string;
  };
}

const { title, description, image } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = Astro.url.pathname === "/" ? title : `${title} · ${siteName}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title set:html={smartypants(pageTitle, 1)} />
    <meta name="description" content={smartypants(description, 1)} />
    <meta property="og:title" content={smartypants(title, 1)} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={smartypants(description, 1)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    {
      image && (
        <>
          <meta property="og:image" content={image.src} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
  </head>
  <body>
    <div class="site-container">
      <!-- Mobile Header -->
      <header class="mobile-header">
        <a href="/" class="brand-link">
          <h1 class="brand-name">Jan Szerling</h1>
        </a>
        <button class="menu-toggle" aria-label="Toggle Menu" id="menuToggle">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
      </header>

      <!-- Collapsible Mobile Menu Drawer -->
      <nav class="mobile-nav" id="mobileNav">
        <a href="/">Portfolio</a>
        <a href="/booking">Online Booking</a>
        <a href="/contact">Contact</a>
        <a href="/licensing">Licensing</a>
        <div class="mobile-socials">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="tel:+48000000000">Phone</a>
        </div>
      </nav>

      <!-- PC Sidebar -->
      <aside class="sidebar">
        <div class="sidebar-top">
          <a href="/" class="brand-link">
            <h1 class="brand-name">Jan Szerling</h1>
          </a>
          <nav class="nav-links">
            <a href="/">Portfolio</a>
            <a href="/booking">Online Booking</a>
            <a href="/contact">Contact</a>
            <a href="/licensing">Licensing</a>
          </nav>
        </div>

        <div class="socials">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg class="social-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg class="social-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="tel:+48000000000" aria-label="Phone">
            <svg class="social-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="main-content">
        <slot />
      </main>
    </div>

    <!-- Simple script for mobile hamburger toggle -->
    <script>
      const toggleBtn = document.getElementById('menuToggle');
      const mobileNav = document.getElementById('mobileNav');
      if (toggleBtn && mobileNav) {
        toggleBtn.addEventListener('click', () => {
          mobileNav.classList.toggle('open');
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .site-container {
    display: flex;
    min-height: 100vh;
  }

  .mobile-header, .mobile-nav {
    display: none !important;
  }

  .sidebar {
    width: 200px;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    background-color: #0b0b0b;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 30px;
    border-right: 1px solid #1a1a1a;
    z-index: 100;
  }

  .brand-link {
    text-decoration: none;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 40px;
    color: #ffffff;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-links a {
    color: #888888;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  .socials {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-icon {
    color: #888888;
    transition: color 0.2s ease;
  }

  .social-icon:hover {
    color: #ffffff;
  }

  .main-content {
    margin-left: 200px;
    flex: 1;
    padding: 40px;
  }

  @media (max-width: 768px) {
    .site-container {
      flex-direction: column;
    }

    .sidebar {
      display: none !important;
    }

    .main-content {
      margin-left: 0;
      padding: 20px 16px;
      margin-top: 70px;
    }

    .mobile-header {
      display: flex !important;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 70px;
      background-color: #0b0b0b;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
      border-bottom: 1px solid #1a1a1a;
      z-index: 1000;
      box-sizing: border-box;
    }

    .mobile-header .brand-name {
      margin-bottom: 0;
      font-size: 1.2rem;
    }

    .menu-toggle {
      background: none;
      border: none;
      color: #ffffff;
      cursor: pointer;
      padding: 4px;
    }

    .mobile-nav {
      display: flex !important;
      flex-direction: column;
      position: fixed;
      top: 70px;
      left: 0;
      width: 100%;
      background-color: #0b0b0b;
      padding: 24px;
      gap: 18px;
      border-bottom: 1px solid #1a1a1a;
      transform: translateY(-120%);
      transition: transform 0.3s ease-in-out;
      z-index: 999;
      box-sizing: border-box;
    }

    .mobile-nav.open {
      transform: translateY(0);
    }

    .mobile-nav a {
      color: #cccccc;
      text-decoration: none;
      font-size: 1.1rem;
    }

    .mobile-socials {
      display: flex;
      gap: 20px;
      margin-top: 12px;
      padding-top: 16px;
      border-top: 1px solid #222222;
    }

    .mobile-socials a {
      font-size: 0.9rem;
      color: #888888;
    }
  }
</style>